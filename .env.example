# PR Review Dashboard — Environment Variables
# Copy to .env and fill in values

# Azure DevOps PAT (required)
AZURE_DEVOPS_PAT=

# Your name in Azure DevOps (matches displayName or uniqueName)
REVIEWER_NAME=FERN

# Repos to poll (comma-separated)
REPOS=*

# Poll interval in minutes
POLL_INTERVAL_MINUTES=10

# Hermes Agent API (set LLM_BACKEND=legacy to use the previous provider chain)
LLM_BACKEND=hermes
HERMES_BASE_URL=http://host.docker.internal:8642/p/pr-review/v1
HERMES_API_KEY=
HERMES_MODEL=pr-review
HERMES_TIMEOUT_SECONDS=450
# Separate shared secret for the dashboard-scoped MCP tools (not the Hermes API key).
HERMES_TOOLS_KEY=
HERMES_REQUIRE_TOOLS=true
# Enable bundled preparation/batched file reads after validating the Hermes MCP setup.
HERMES_BATCH_WORKFLOW=false
